{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Davinci agent report",
  "type": "object",
  "required": [
    "agent",
    "status",
    "files_changed",
    "criteria_addressed",
    "verification",
    "assumptions",
    "handoff_notes"
  ],
  "properties": {
    "agent": {
      "type": "string"
    },
    "status": {
      "enum": [
        "complete",
        "blocked",
        "needs_input"
      ]
    },
    "files_changed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "criteria_addressed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verification": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "cmd",
          "exit_code"
        ],
        "properties": {
          "cmd": {
            "type": "string"
          },
          "exit_code": {
            "type": "integer"
          }
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "handoff_notes": {
      "type": "string"
    },
    "verdict": {
      "enum": [
        "pass",
        "fail"
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "severity",
          "criterion",
          "description"
        ],
        "properties": {
          "severity": {
            "enum": [
              "blocking",
              "advisory"
            ]
          },
          "criterion": {
            "type": "string"
          },
          "file": {
            "type": "string"
          },
          "line": {
            "type": "integer"
          },
          "description": {
            "type": "string"
          }
        }
      }
    }
  }
}
