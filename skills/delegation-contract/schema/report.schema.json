{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Davinci agent report",
  "type": "object",
  "required": [
    "agent",
    "status",
    "files_changed",
    "criteria_addressed",
    "verification",
    "assumptions",
    "handoff_notes",
    "model"
  ],
  "properties": {
    "agent": {
      "type": "string"
    },
    "status": {
      "enum": [
        "complete",
        "blocked",
        "needs_input"
      ]
    },
    "files_changed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "criteria_addressed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verification": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "cmd",
          "exit_code"
        ],
        "properties": {
          "cmd": {
            "type": "string"
          },
          "exit_code": {
            "type": "integer"
          }
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "handoff_notes": {
      "type": "string"
    },
    "verdict": {
      "enum": [
        "pass",
        "fail"
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "severity",
          "criterion",
          "description"
        ],
        "properties": {
          "severity": {
            "enum": [
              "blocking",
              "advisory"
            ]
          },
          "criterion": {
            "type": "string"
          },
          "file": {
            "type": "string"
          },
          "line": {
            "type": "integer"
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "questions": {
      "type": "array",
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": [
          "question",
          "options",
          "default"
        ],
        "properties": {
          "question": {
            "type": "string"
          },
          "options": {
            "type": "array",
            "minItems": 2,
            "maxItems": 4,
            "items": {
              "type": "string"
            }
          },
          "default": {
            "type": "string"
          }
        }
      }
    },
    "tier": {
      "enum": [
        "load-bearing",
        "standard",
        "scaffolding"
      ]
    },
    "observations": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": [
          "observation",
          "impact",
          "recommendation"
        ],
        "properties": {
          "observation": {
            "type": "string"
          },
          "where": {
            "type": "string"
          },
          "impact": {
            "type": "string"
          },
          "recommendation": {
            "type": "string"
          }
        }
      }
    },
    "model": {
      "enum": [
        "opus",
        "sonnet",
        "haiku",
        "fable",
        "unspecified"
      ]
    }
  }
}
