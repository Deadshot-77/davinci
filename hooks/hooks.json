{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/enforce-write-scope.js"
            ],
            "statusMessage": "Checking write scope..."
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "davinci:infra-architect|davinci:backend-engineer|davinci:frontend-engineer|davinci:security-engineer|davinci:code-reviewer|davinci:review-lens|davinci:implementer|infra-architect|backend-engineer|frontend-engineer|security-engineer|code-reviewer|review-lens|implementer",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/validate-report.js"
            ],
            "statusMessage": "Validating agent report..."
          }
        ]
      }
    ]
  }
}
